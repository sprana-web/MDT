@prefix : <http://www.OntoMM.org//> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obda: <https://w3id.org/obda/vocabulary#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.OntoMM.org//> .

<http://www.OntoMM.org/> rdf:type owl:Ontology ;
                          owl:imports <http://www.opengis.net/ont/geosparql> ;
                          <http://www.w3.org/2004/02/skos/core#definition> "A lake-catchment ontology for integrating environmental, geospatial, administrative, and monitoring information."@en ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Lake-catchment ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/source
<http://purl.org/dc/elements/1.1/source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty ;
                                                <https://prez.dev/description> "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en ,
                                                                               "The preferred lexical label for a resource, in a given language."@en ,
                                                                               "The range of skos:prefLabel is the class of RDF plain literals."@en ,
                                                                               """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en ;
                                                <https://prez.dev/label> "preferred label"@en .


###  https://prez.dev/currentProfile
<https://prez.dev/currentProfile> rdf:type owl:AnnotationProperty .


###  https://prez.dev/description
<https://prez.dev/description> rdf:type owl:AnnotationProperty .


###  https://prez.dev/label
<https://prez.dev/label> rdf:type owl:AnnotationProperty .


###  https://prez.dev/type
<https://prez.dev/type> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.opengis.net/ont/geosparql#wktLiteral
geo:wktLiteral rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.OntoMM.org//connectsTo
:connectsTo rdf:type owl:ObjectProperty ;
            rdfs:domain :River ;
            rdfs:range :Lake ;
            rdfs:comment "connectsTo" .


###  http://www.OntoMM.org//hasIDN
:hasIDN rdf:type owl:ObjectProperty ;
        rdfs:domain :Features ;
        rdfs:range :WeatherStation .


###  http://www.OntoMM.org//hasObservation
:hasObservation rdf:type owl:ObjectProperty ;
                rdfs:domain :WeatherStation ;
                rdfs:range :Observation .


###  http://www.OntoMM.org//hasSubCatchmentArea
:hasSubCatchmentArea rdf:type owl:ObjectProperty .


###  http://www.OntoMM.org//intersectsProtectedArea
:intersectsProtectedArea rdf:type owl:ObjectProperty ;
                         rdfs:domain :River ;
                         rdfs:range :ProtectedArea .


###  http://www.OntoMM.org//locatedAt
:locatedAt rdf:type owl:ObjectProperty ;
           rdfs:domain :WeatherStation ;
           rdfs:range :Features ;
           rdfs:label "locatedAt" .


###  http://www.OntoMM.org//locatedIn
:locatedIn rdf:type owl:ObjectProperty ;
           rdfs:domain :Features ;
           rdfs:range :Features ;
           rdfs:label "locatedIn" .


###  http://www.OntoMM.org//monitors
:monitors rdf:type owl:ObjectProperty ;
          rdfs:domain :WeatherStation ;
          rdfs:range :Observation ;
          rdfs:label "monitors" .


###  http://www.OntoMM.org//observedProperty
:observedProperty rdf:type owl:ObjectProperty ;
                  rdfs:domain :Observation ;
                  rdfs:range :ObservedProperty ;
                  rdfs:label "observed property"@en .


###  http://www.opengis.net/ont/geosparql#hasDefaultGeometry
geo:hasDefaultGeometry rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf geo:hasGeometry ;
                       rdfs:domain geo:Feature ;
                       rdfs:range geo:Geometry .


###  http://www.opengis.net/ont/geosparql#hasGeometry
geo:hasGeometry rdf:type owl:ObjectProperty ;
                rdfs:domain geo:Feature ;
                rdfs:range geo:Geometry .


#################################################################
#    Data properties
#################################################################

###  http://www.OntoMM.org//hasAirTemp
:hasAirTemp rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Observation ;
            rdfs:range xsd:float ;
            rdfs:label "hasAirTemperature" .


###  http://www.OntoMM.org//hasArea
:hasArea rdf:type owl:DatatypeProperty ;
         rdfs:domain :Features ;
         rdfs:range xsd:float ;
         rdfs:label "hasArea" .


###  http://www.OntoMM.org//hasClass
:hasClass rdf:type owl:DatatypeProperty ;
          rdfs:domain :Point ;
          rdfs:range rdfs:Literal .


###  http://www.OntoMM.org//hasCouncilName
:hasCouncilName rdf:type owl:DatatypeProperty ;
                rdfs:domain :WeatherStation ;
                rdfs:range xsd:string .


###  http://www.OntoMM.org//hasDischarge
:hasDischarge rdf:type owl:DatatypeProperty ;
              rdfs:domain :Observation ;
              rdfs:range xsd:double .


###  http://www.OntoMM.org//hasElevation
:hasElevation rdf:type owl:DatatypeProperty ;
              rdfs:domain :Features ;
              rdfs:range xsd:float ;
              rdfs:label "hasElevation" .


###  http://www.OntoMM.org//hasGeo
:hasGeo rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :Features .


###  http://www.OntoMM.org//hasID
:hasID rdf:type owl:DatatypeProperty ;
       rdfs:domain :Features ;
       rdfs:range rdfs:Literal .


###  http://www.OntoMM.org//hasLat
:hasLat rdf:type owl:DatatypeProperty ;
        rdfs:domain :WeatherStation ;
        rdfs:range xsd:float ;
        rdfs:label "hasLatitude" .


###  http://www.OntoMM.org//hasLength
:hasLength rdf:type owl:DatatypeProperty ;
           rdfs:domain :River ;
           rdfs:range xsd:float .


###  http://www.OntoMM.org//hasLong
:hasLong rdf:type owl:DatatypeProperty ;
         rdfs:domain :WeatherStation ;
         rdfs:range xsd:float ;
         rdfs:label "hasLongitude" .


###  http://www.OntoMM.org//hasMasl
:hasMasl rdf:type owl:DatatypeProperty .


###  http://www.OntoMM.org//hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:domain :Features ;
         rdfs:range rdfs:Literal ,
                    xsd:string ;
         rdfs:label "hasName" .


###  http://www.OntoMM.org//hasPop
:hasPop rdf:type owl:DatatypeProperty ;
        rdfs:domain :Municipality ;
        rdfs:range xsd:integer .


###  http://www.OntoMM.org//hasProtectionCategory
:hasProtectionCategory rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ProtectedArea ;
                       rdfs:range xsd:string .


###  http://www.OntoMM.org//hasResult
:hasResult rdf:type owl:DatatypeProperty ;
           rdfs:domain :Observation .


###  http://www.OntoMM.org//hasWLevel
:hasWLevel rdf:type owl:DatatypeProperty ;
           rdfs:domain :Observation .


###  http://www.OntoMM.org//hasWaterLevel
:hasWaterLevel rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :Observation ;
               rdfs:range xsd:float .


###  http://www.OntoMM.org//hasWaterTemp
:hasWaterTemp rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :Observation ;
              rdfs:range xsd:float ;
              rdfs:label "hasWaterTemperature" .


###  http://www.OntoMM.org//resultTime
:resultTime rdf:type owl:DatatypeProperty ;
            rdfs:domain :Observation ;
            rdfs:range xsd:dateTime .


###  http://www.opengis.net/ont/geosparql#asWKT
geo:asWKT rdf:type owl:DatatypeProperty ;
          rdfs:domain geo:Geometry ;
          rdfs:range geo:wktLiteral .


#################################################################
#    Classes
#################################################################

###  http://www.OntoMM.org//CatchmentArea
:CatchmentArea rdf:type owl:Class ;
               rdfs:subClassOf :WatershedArea ;
               rdfs:label "CatchmentArea" .


###  http://www.OntoMM.org//Features
:Features rdf:type owl:Class ;
          rdfs:subClassOf geo:Feature .


###  http://www.OntoMM.org//Lake
:Lake rdf:type owl:Class ;
      rdfs:subClassOf :Features ;
      rdfs:label "Lake" .


###  http://www.OntoMM.org//Municipality
:Municipality rdf:type owl:Class ;
              rdfs:subClassOf :Features .


###  http://www.OntoMM.org//Observation
:Observation rdf:type owl:Class ;
             rdfs:label "Observation" .


###  http://www.OntoMM.org//ObservedProperty
:ObservedProperty rdf:type owl:Class ;
                  rdfs:label "Observed property"@en .


###  http://www.OntoMM.org//Point
:Point rdf:type owl:Class ;
       rdfs:subClassOf :Features .


###  http://www.OntoMM.org//ProtectedArea
:ProtectedArea rdf:type owl:Class ;
               rdfs:subClassOf :Features ;
               rdfs:label "Protected area"@en .


###  http://www.OntoMM.org//River
:River rdf:type owl:Class ;
       rdfs:subClassOf :Features ;
       rdfs:label "River" .


###  http://www.OntoMM.org//WatershedArea
:WatershedArea rdf:type owl:Class ;
               rdfs:subClassOf :Features .


###  http://www.OntoMM.org//WeatherStation
:WeatherStation rdf:type owl:Class ;
                rdfs:subClassOf :Features ;
                rdfs:label "WeatherStation" .


###  http://www.opengis.net/ont/geosparql#Feature
geo:Feature rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Geometry
geo:Geometry rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.OntoMM.org//airTemperature
:airTemperature rdf:type owl:NamedIndividual ,
                         :ObservedProperty .


###  http://www.OntoMM.org//discharge
:discharge rdf:type owl:NamedIndividual ,
                    :ObservedProperty .


###  http://www.OntoMM.org//waterLevel
:waterLevel rdf:type owl:NamedIndividual ,
                     :ObservedProperty .


###  http://www.OntoMM.org//waterTemperature
:waterTemperature rdf:type owl:NamedIndividual ,
                           :ObservedProperty .


###  http://www.opengis.net/def/function/geosparql/
<http://www.opengis.net/def/function/geosparql/> rdf:type owl:NamedIndividual ,
                                                          <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                                 <http://purl.org/dc/elements/1.1/source> <http://www.opengis.net/doc/geosparql/1.0> ;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "GeoSPARQL Functions	" ;
                                                 <https://prez.dev/label> "GeoSPARQL Functions	" ;
                                                 <https://prez.dev/type> <https://prez.dev/FocusNode> .


