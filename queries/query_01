Query 1. Identifying Farms Near Vismunda and Protected Areas Intersected by the River. 

PREFIX :     <http://www.OntoMM.org//>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT DISTINCT
    ?farm
    ?farmName
    ?river
    ?riverName
    ?protectedArea
    ?protectedAreaName
    ?distanceToRiver
    ?geometry
WHERE {
    # Select one river first
    ?river a :River ;
           :hasName ?riverName ;
           geo:hasDefaultGeometry/geo:asWKT ?riverWKT .

    FILTER(STR(?riverName) = "Vismunda")

    # Protected areas intersected by the selected river
    ?protectedArea a :ProtectedArea ;
                   :hasName ?protectedAreaName ;
                   geo:hasDefaultGeometry/geo:asWKT ?protectedWKT .

    FILTER(geof:sfIntersects(?riverWKT, ?protectedWKT))

    # Farms near the selected river
    ?farm a :Point ;
          :hasClass ?pointClass ;
          :hasName ?farmName ;
          geo:hasDefaultGeometry/geo:asWKT ?geometry .

    FILTER(LCASE(STR(?pointClass)) = "farm")

    BIND(
        geof:distance(
            ?geometry,
            ?riverWKT,
            <http://www.opengis.net/def/uom/OGC/1.0/metre>
        ) AS ?distanceToRiver
    )

    FILTER(?distanceToRiver <= 500)
}
LIMIT 100
